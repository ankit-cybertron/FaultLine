GROQ_API_KEY=your_groq_api_key_here

# Investigator: needs reliable tool-calling. llama-3.3-70b-versatile is the default pick.
# Tested candidates: llama-3.3-70b-versatile, qwen-qwq-32b, llama-3.1-70b-versatile
INVESTIGATOR_MODEL=llama-3.3-70b-versatile

# Judge: many short calls per diagnosis. 8b is fast enough when the slice is small.
# Ablation: swap to llama-3.3-70b-versatile to see if accuracy improves.
JUDGE_MODEL=llama-3.1-8b-instant

FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# One graph name per dataset / tenant
GRAPH_TRAIL=runs_trail
GRAPH_DEMO=runs_demo

# How many steps backward to chase per slice (keeps FalkorDB query bounded)
SLICE_DEPTH=8

# Disk cache directory for LLM responses
CACHE_DIR=.cache/llm

# Max tokens FaultLine will send to any single LLM call
# Keeps us inside Groq free-tier per-request limits
MAX_INPUT_TOKENS=6000
